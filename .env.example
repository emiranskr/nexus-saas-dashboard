# Yerel Geliştirme (SQLite - Sıfır kurulum gerektirir)
DATABASE_URL="file:./dev.db"

# Üretim Ortamı (PostgreSQL - Supabase / Neon / AWS RDS / Railway)
# DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# NextAuth Güvenlik Ayarları
# Production ortamında NEXTAUTH_SECRET zorunludur ve en az 32 karakter olmalıdır.
# Güçlü ve güvenli bir anahtar üretmek için terminalde: openssl rand -base64 32
# Uyarı: Production ortamında varsayılan veya tahmin edilebilir değerler kullanılamaz; uygulama başlamayı reddeder.
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
